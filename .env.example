# Copy to .env and set either local paths under MODEL_ROOT or Hub IDs.
RUNTIME_TAG=83ad767eed3be3ee7f2df63be693bfaca5c7c922-49819
# Local-only tag produced by scripts/build-image.sh; Compose never pulls it.
RUNTIME_IMAGE=north-mini-code-runtime:${RUNTIME_TAG}
VLLM_SOURCE_DIR=.work/vllm

# Local model directories are mounted read-only at /models. Hub IDs also work;
# in that case vLLM uses the named hf-cache volume and may need HF_TOKEN.
MODEL_ROOT=/home/douglasbrown/Models
DFLASH_MODEL=/models/North-Mini-Code-1.0-dflash
DSPARK_MODEL=/models/North-Mini-Code-1.0-dspark

# Optional local-verifier deployment. The release draft config embeds the
# verifier as a Hub ID, so vLLM would fetch the target from the Hub. To serve
# from local storage instead, build a deployment bundle that points the
# verifier at a local directory:
#   VERIFIER_MODEL=/models/North-Mini-Code-1.0-w4a16 RUNTIME_WORK=$MODEL_ROOT/.deploy \
#     scripts/prepare-deployment-model.sh dflash
# then set DFLASH_MODEL (and/or DSPARK_MODEL) to the printed bundle path below.
VERIFIER_MODEL=
RUNTIME_WORK=
HF_TOKEN=

# Validated North path defaults. DSpark portability is GB10-only evidence.
TP_SIZE=1
VLLM_USE_V2_MODEL_RUNNER=1
MAX_MODEL_LEN=320000
# 0.75 leaves unified-memory headroom on GB10. Raise only after a local gate.
GPU_MEMORY_UTILIZATION=0.75

DFLASH_HOST_PORT=8001
DSPARK_HOST_PORT=8002
SHM_SIZE=16g
