# Thin overlay on the official published vLLM image.
#
# - Base: official vllm/vllm-openai (released version), which already includes
#   DFlash/DSpark support and Model Runner V2 thinking-budget support upstream.
# - Overlay (pure-Python; both post-date the releases and are absent from the
#   official image), rendered into patched files by scripts/build-image.sh and
#   copied over the installed modules here. No CUDA/source compilation happens;
#   the wheel and native kernels come from the official base, unchanged.
#     PR #49819  Cohere2MoE Eagle3 auxiliary hidden states (required by draft).
#     PR #50937  Skip empty/unused expert bias on load (our checkpoint ships an
#                all-zero per-expert bias).
#
# Build context is a small staging dir produced by scripts/build-image.sh, so
# nothing else from the repo is sent to the daemon.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

COPY runtime.txt /tmp/runtime.txt
COPY healthcheck.py /opt/north-runtime/healthcheck.py
COPY cohere2_moe.py /tmp/cohere2_moe.patched.py
COPY routed_experts.py /tmp/routed_experts.patched.py

# Overlay the patched modules into the installed vLLM site-packages.
RUN python3 - <<'PY'
import os, shutil
import vllm
pkg = os.path.dirname(vllm.__file__)
for rel, src in (
    ("model_executor/models/cohere2_moe.py", "/tmp/cohere2_moe.patched.py"),
    ("model_executor/layers/fused_moe/routed_experts.py", "/tmp/routed_experts.patched.py"),
):
    dst = os.path.join(pkg, rel)
    os.chmod(dst, 0o644)
    shutil.copy(src, dst)
    print("overlayed", rel, "->", dst)
PY

# Runtime-only deps (does not touch vLLM's wheel or native extensions).
RUN python3 -m pip install --no-cache-dir -r /tmp/runtime.txt \
    && rm /tmp/runtime.txt

# Verify the patched interfaces are importable in the final image.
RUN python3 - <<'PY'
from vllm.model_executor.models.cohere2_moe import Cohere2MoeForCausalLM
from vllm.model_executor.models.interfaces import supports_eagle3
from vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts
assert supports_eagle3(Cohere2MoeForCausalLM), "Cohere2MoE aux hidden states not active"
print("final image overlay import passed (Eagle3 aux + RoutedExperts)")
PY
