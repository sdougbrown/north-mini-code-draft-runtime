+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Regression for a speculative batch crossing Command 4's phase boundary."""
+
+from vllm.reasoning.cohere_command_reasoning_parser import (
+    CohereCommand4ReasoningParser,
+)
+
+
+class TransitionTokenizer:
+    """Only the special-token decoding needed by this parser-boundary test."""
+
+    tokens = {
+        "<|START_THINKING|>": 1,
+        "<|END_THINKING|>": 2,
+        "<|CHATBOT_TOKEN|>": 3,
+        "<|START_ACTION|>": 4,
+    }
+    decoded = {
+        1: "<|START_THINKING|>",
+        2: "<|END_THINKING|>",
+        4: "<|START_ACTION|>",
+        18: ".",
+    }
+
+    def convert_tokens_to_ids(self, token: str) -> int:
+        return self.tokens.get(token, 0)
+
+    def get_vocab(self) -> dict[str, int]:
+        return {}
+
+    def decode(self, ids: list[int], skip_special_tokens: bool = False) -> str:
+        return "".join(self.decoded[token] for token in ids)
+
+
+def test_cmd4_preserves_structural_suffix_from_mixed_speculative_delta():
+    """[18, END_THINKING, START_ACTION] must enter the tool-parser phase intact."""
+    tokenizer = TransitionTokenizer()
+    parser = CohereCommand4ReasoningParser(tokenizer)
+
+    parser.extract_reasoning_streaming(
+        previous_text="",
+        current_text="<|START_THINKING|>",
+        delta_text="<|START_THINKING|>",
+        previous_token_ids=[],
+        current_token_ids=[1],
+        delta_token_ids=[1],
+    )
+    delta = parser.extract_reasoning_streaming(
+        previous_text="<|START_THINKING|>",
+        current_text="<|START_THINKING|>.",
+        delta_text=".",
+        previous_token_ids=[1],
+        current_token_ids=[1, 18, 2, 4],
+        delta_token_ids=[18, 2, 4],
+    )
+
+    assert delta is not None
+    assert delta.reasoning == "."
+    assert delta.content == "<|START_ACTION|>"
+    assert parser.extract_content_ids([18, 2, 4]) == [4]
